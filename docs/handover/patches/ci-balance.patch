+        timer = setTimeout(() => reject(new Error(`${phase} exceeded its remaining budget: ${JSON.stringify(lifecycle.output())}`)), Math.max(1, timeoutMs))
+      })])
+    } finally { if (timer !== undefined) clearTimeout(timer) }
