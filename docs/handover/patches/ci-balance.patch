@@ -156,15 +156,24 @@ jobs:
       - name: Verify package packs
         run: pnpm run pack:check
 
+      - name: Retain package test diagnostics
+        if: ${{ always() }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: linux-package-tests-attempt-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/package-tests.log
+          if-no-files-found: ignore
+          retention-days: 7
+
   linux-root-tests:
     runs-on: ubuntu-latest
     timeout-minutes: 35
     strategy:
       fail-fast: false
       matrix:
-        # The root suite is the longest lane. Two shards halve its wall clock;
-        # a failing shard never cancels the sibling, so a real failure is
-        # reported with its own log.
+        # The root sequencer puts the two slow installer groups on separate
+        # runners and keeps Vitest's default split for other files. A failing
+        # shard never cancels its sibling.
         shard: [1, 2]
 
     steps:
@@ -270,13 +279,49 @@ jobs:
         shell: bash
         run: |
           set -o pipefail
-          if ! pnpm exec vitest run --config ./tests/vitest.config.ts --testTimeout=15000 --dir tests --shard=${{ matrix.shard }}/2 > "${RUNNER_TEMP}/root-tests.log" 2>&1; then
+          if ! pnpm exec vitest run --config ./tests/vitest.config.ts --testTimeout=15000 --dir tests --shard=${{ matrix.shard }}/2 --reporter=default --reporter=json --outputFile.json="${RUNNER_TEMP}/root-tests.json" > "${RUNNER_TEMP}/root-tests.log" 2>&1; then
             grep -aE '(^| )(FAIL|×) |AssertionError|Error: ' "${RUNNER_TEMP}/root-tests.log" \
               | grep -av 'ExperimentalWarning' | head -40 \
               | sed -e 's/%/%25/g' -e 's/\r//g' -e 's/^/::error::/' || true
             tail -30 "${RUNNER_TEMP}/root-tests.log" | sed -e 's/%/%25/g' -e 's/\r//g' -e 's/^/::error::/' || true
             exit 1
           fi
+          tail -10 "${RUNNER_TEMP}/root-tests.log"
+
+      - name: Summarize root test timings
+        if: ${{ always() }}
+        shell: bash
+        run: |
+          node --input-type=module <<'NODE'
+          import { appendFileSync, existsSync, readFileSync } from 'node:fs';
+          import { join, relative } from 'node:path';
+          const file = join(process.env.RUNNER_TEMP, 'root-tests.json');
+          if (!existsSync(file)) process.exit(0);
+          const report = JSON.parse(readFileSync(file, 'utf8'));
+          const files = report.testResults.map(suite => ({
+            path: relative(process.cwd(), suite.name),
+            seconds: (suite.endTime - suite.startTime) / 1000,
+          })).sort((left, right) => right.seconds - left.seconds);
+          const summary = [
+            '### Root test timings',
+            `${report.numPassedTests} passed, ${report.numFailedTests} failed, ${report.numPendingTests} skipped.`,
+            '', '| Test file | Seconds |', '| --- | ---: |',
+            ...files.slice(0, 15).map(file => `| ${file.path} | ${file.seconds.toFixed(2)} |`), '',
+          ].join('\n');
+          console.log(summary);
+          appendFileSync(process.env.GITHUB_STEP_SUMMARY, summary);
+          NODE
+
+      - name: Retain root test diagnostics
+        if: ${{ always() }}
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: linux-root-tests-${{ matrix.shard }}-attempt-${{ github.run_attempt }}
+          path: |
+            ${{ runner.temp }}/root-tests.log
+            ${{ runner.temp }}/root-tests.json
+          if-no-files-found: ignore
+          retention-days: 7
 
   verify:
     needs: [linux-packages, linux-root-tests, macos-verify, windows-acp-smoke]
