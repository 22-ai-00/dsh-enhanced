    "content": "import { readFileSync } from 'node:fs';\n\nconst orders = JSON.parse(readFileSync(0, 'utf8'));\nconst totals = {};\n\nfor (const order of orders) {\n  if (order.status === 'cancelled') continue;\n  totals[order.currency] = (totals[order.currency] ?? 0) + order.amountCents;\n}\n\nconst sortedTotals = Object.fromEntries(\n  Object.entries(totals).sort(([left], [right]) => left.localeCompare(right)),\n);\n\nprocess.stdout.write(`${JSON.stringify(sortedTotals)}\\n`);\n"
  },
