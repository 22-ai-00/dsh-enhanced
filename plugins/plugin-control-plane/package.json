{
  "name": "@dsh-enhanced/plugin-control-plane",
  "version": "0.1.48",
  "description": "A durable capability-gap, approval and staged plugin activation control plane for DSH.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "dsh-plugin-control": "./bin/dsh-plugin-control.js",
    "dsh-source-approval-authority": "./bin/dsh-source-approval-authority.js",
    "dsh-source-release-authority": "./bin/dsh-source-release-authority.js",
    "dsh-source-adoption-authority": "./bin/dsh-source-adoption-authority.js",
    "dsh-task-observation-authority": "./bin/dsh-task-observation-authority.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/22-ai-00/dsh-enhanced.git",
    "directory": "plugins/plugin-control-plane"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-scope": ">=0.1.5-rc.3 <0.1.6",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.3 <0.1.6",
    "@dsh-enhanced/assistant-automations": ">=0.1.33 <0.2.0",
    "@dsh-enhanced/assistant-delivery": ">=0.1.33 <0.2.0",
    "@dsh-enhanced/assistant-evaluation": ">=0.1.33 <0.2.0",
    "@dsh-enhanced/assistant-verifier": ">=0.1.33 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@dsh-enhanced/assistant-automations": {
      "optional": true
    },
    "@dsh-enhanced/assistant-delivery": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@dsh-enhanced/assistant-evaluation": {
      "optional": true
    },
    "@dsh-enhanced/assistant-verifier": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/cordis-plugin-loader": "catalog:",
    "@deepseek-ai/dsh-scope": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@dsh-enhanced/assistant-automations": "workspace:*",
    "@dsh-enhanced/assistant-delivery": "workspace:*",
    "@dsh-enhanced/assistant-evaluation": "workspace:*",
    "@dsh-enhanced/assistant-policy": "workspace:*",
    "@dsh-enhanced/assistant-verifier": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
