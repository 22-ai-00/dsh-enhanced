{
  "name": "@dsh-enhanced/assistant-web-owner",
  "version": "0.1.32",
  "description": "A DeepSeek Harness plugin for Assistant Web Owner.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "dsh-autonomy-doctor": "./bin/dsh-autonomy-doctor.js",
    "dsh-web-owner-setup": "./bin/dsh-web-owner-setup.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/build-client.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/22-ai-00/dsh-enhanced.git",
    "directory": "plugins/assistant-web-owner"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@dsh-enhanced/event-triggers": ">=0.1.24 <0.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.2-rc.1 <0.2.0",
    "@dsh-enhanced/assistant-delivery": ">0.1.24 <0.2.0",
    "@dsh-enhanced/assistant-isolation": ">=0.1.0 <0.2.0",
    "@dsh-enhanced/assistant-goals": ">=0.1.0 <0.2.0",
    "@dsh-enhanced/assistant-verifier": ">=0.1.0 <0.2.0",
    "@dsh-enhanced/assistant-deepseek-budget": ">=0.1.0 <0.2.0",
    "@dsh-enhanced/assistant-actions": ">=0.1.24 <0.2.0",
    "@dsh-enhanced/assistant-skills": ">=0.1.0 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@dsh-enhanced/event-triggers": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@dsh-enhanced/assistant-delivery": {
      "optional": true
    },
    "@dsh-enhanced/assistant-isolation": {
      "optional": true
    },
    "@dsh-enhanced/assistant-goals": {
      "optional": true
    },
    "@dsh-enhanced/assistant-verifier": {
      "optional": true
    },
    "@dsh-enhanced/assistant-deepseek-budget": {
      "optional": true
    },
    "@dsh-enhanced/assistant-actions": {
      "optional": true
    },
    "@dsh-enhanced/assistant-skills": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dsh-enhanced/event-triggers": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-api-gateway": "catalog:",
    "@deepseek-ai/dsh-typert-registry": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-attachment": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:",
    "@dsh-enhanced/assistant-delivery": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "~18.3.1",
    "esbuild": "^0.27.0",
    "react": "^18.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@dsh-enhanced/assistant-isolation": "workspace:*",
    "@dsh-enhanced/assistant-goals": "workspace:*",
    "@dsh-enhanced/assistant-verifier": "workspace:*",
    "@dsh-enhanced/assistant-deepseek-budget": "workspace:*",
    "@dsh-enhanced/assistant-actions": "workspace:*",
    "@dsh-enhanced/assistant-skills": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "zod": "catalog:",
    "yaml": "2.9.0"
  }
}
