{
  "name": "@dsh-ray/assistant-skills",
  "version": "0.1.89",
  "description": "Capture independently accepted tool workflows and replay versioned skills through the current native Goal and tool authority.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./holdout-authority": {
      "types": "./lib/holdout-authority.d.ts",
      "default": "./lib/holdout-authority.js"
    },
    "./holdout-qualification": {
      "types": "./lib/holdout-qualification.d.ts",
      "default": "./lib/holdout-qualification.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/22-ai-00/dsh-ray.git",
    "directory": "plugins/assistant-skills"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "protection": {
      "floor": "immutable"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5 <0.3.0",
    "@dsh-ray/assistant-delivery": ">=0.1.0 <0.2.0",
    "@dsh-ray/assistant-evaluation": ">0.1.24 <0.2.0",
    "@dsh-ray/assistant-goals": ">=0.1.25 <0.2.0",
    "@dsh-ray/assistant-isolation": ">=0.1.0 <0.2.0",
    "@dsh-ray/assistant-policy": ">=0.1.0 <0.2.0",
    "@dsh-ray/assistant-recovery": ">=0.1.0 <0.2.0",
    "@deepseek-ai/dsh-fs": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-fs-local": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.5 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@dsh-ray/assistant-delivery": {
      "optional": true
    },
    "@dsh-ray/assistant-policy": {
      "optional": true
    },
    "@dsh-ray/assistant-goals": {
      "optional": true
    },
    "@dsh-ray/assistant-evaluation": {
      "optional": true
    },
    "@dsh-ray/assistant-isolation": {
      "optional": true
    },
    "@dsh-ray/assistant-recovery": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-agent-loop": "catalog:",
    "@deepseek-ai/dsh-agent-loop-testkit": "catalog:",
    "@deepseek-ai/dsh-fs-observation-policy": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-scope": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-skill": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/dsh-tool-executor-native": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@dsh-ray/assistant-delivery": "workspace:*",
    "@dsh-ray/assistant-evaluation": "workspace:*",
    "@dsh-ray/assistant-goals": "workspace:*",
    "@dsh-ray/assistant-isolation": "workspace:*",
    "@dsh-ray/assistant-policy": "workspace:*",
    "@dsh-ray/assistant-recovery": "workspace:*",
    "@dsh-ray/assistant-verifier": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/cordis-plugin-loader": "catalog:",
    "@deepseek-ai/dsh-fs": "catalog:",
    "@deepseek-ai/dsh-fs-local": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-tool-fs": "catalog:",
    "@deepseek-ai/dsh-working-directory": "catalog:"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "@dsh-ray/task-acceptance-contract": "workspace:*"
  },
  "bin": {
    "dsh-skill-holdout": "./lib/holdout-cli.js"
  }
}
