{
  "name": "@dsh-enhanced/owner-console",
  "version": "0.1.70",
  "description": "A DeepSeek Harness plugin for Owner Console.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/build-client.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:assets": "node ./scripts/build-assets.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/22-ai-00/dsh-enhanced.git",
    "directory": "plugins/owner-console"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/dsh-typert-registry": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "esbuild": "^0.27.0",
    "jsdom": "^29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "yaml": "2.9.0",
    "zod": "catalog:"
  }
}
