{
  "name": "@dsh-enhanced/assistant-proactive",
  "version": "0.1.33",
  "description": "Owner-authorized goal event opportunity filtering with durable utility decisions and cooldowns.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/22-ai-00/dsh-enhanced.git",
    "directory": "plugins/assistant-proactive"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0",
    "@dsh-enhanced/assistant-policy": ">=0.1.24 <0.2.0",
    "@dsh-enhanced/assistant-delivery": ">=0.1.24 <0.2.0",
    "@dsh-enhanced/assistant-automations": ">=0.1.24 <0.2.0",
    "@dsh-enhanced/assistant-goals": ">=0.1.24 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@dsh-enhanced/assistant-policy": {
      "optional": true
    },
    "@dsh-enhanced/assistant-delivery": {
      "optional": true
    },
    "@dsh-enhanced/assistant-automations": {
      "optional": true
    },
    "@dsh-enhanced/assistant-goals": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@dsh-enhanced/assistant-policy": "workspace:^",
    "@dsh-enhanced/assistant-delivery": "workspace:^",
    "@dsh-enhanced/assistant-automations": "workspace:^",
    "@dsh-enhanced/assistant-goals": "workspace:^"
  },
  "dependencies": {
    "@dsh-enhanced/task-acceptance-contract": "workspace:^",
    "@deepseek-ai/schemastery": "catalog:"
  }
}
