{
  "name": "@dsh-enhanced/assistant-association",
  "version": "0.1.79",
  "description": "Sub-5ms in-memory associative recall over SQLite-backed memory, goal, work-item, automation, and episode graphs for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/22-ai-00/dsh-enhanced.git",
    "directory": "plugins/assistant-association"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "protection": {
      "floor": "model-proposal"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "@dsh-enhanced/assistant-growth-contract": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0",
    "@dsh-enhanced/assistant-automations": ">=0.1.0 <0.2.0",
    "@dsh-enhanced/assistant-delivery": ">=0.1.0 <0.2.0",
    "@dsh-enhanced/assistant-evaluation": ">=0.1.0 <0.2.0",
    "@dsh-enhanced/assistant-goals": ">=0.1.0 <0.2.0",
    "@dsh-enhanced/assistant-policy": ">=0.1.0 <0.2.0",
    "@dsh-enhanced/assistant-work-items": ">=0.1.0 <0.2.0",
    "@dsh-enhanced/personal-memory": ">=0.1.0 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@dsh-enhanced/assistant-automations": { "optional": true },
    "@dsh-enhanced/assistant-delivery": { "optional": true },
    "@dsh-enhanced/assistant-evaluation": { "optional": true },
    "@dsh-enhanced/assistant-goals": { "optional": true },
    "@dsh-enhanced/assistant-policy": { "optional": true },
    "@dsh-enhanced/assistant-work-items": { "optional": true },
    "@dsh-enhanced/personal-memory": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-agent-loop": "catalog:",
    "@deepseek-ai/dsh-agent-loop-testkit": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-tool-executor-native": "catalog:",
    "@dsh-enhanced/assistant-automations": "workspace:*",
    "@dsh-enhanced/assistant-delivery": "workspace:*",
    "@dsh-enhanced/assistant-evaluation": "workspace:*",
    "@dsh-enhanced/assistant-goals": "workspace:*",
    "@dsh-enhanced/assistant-policy": "workspace:*",
    "@dsh-enhanced/assistant-work-items": "workspace:*",
    "@dsh-enhanced/personal-memory": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
