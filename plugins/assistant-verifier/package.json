{
  "name": "@dsh-ray/assistant-verifier",
  "version": "0.2.0",
  "description": "Independent, bounded task acceptance verification with durable contracts and receipts.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./plugin-behavior-runner": {
      "types": "./lib/plugin-behavior-runner.d.ts",
      "default": "./lib/plugin-behavior-runner.js"
    },
    "./plugin-behavior-config": {
      "types": "./lib/plugin-behavior-config.d.ts",
      "default": "./lib/plugin-behavior-config.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./linux-behavior-runtime": {
      "types": "./lib/linux-behavior-runtime.d.ts",
      "default": "./lib/linux-behavior-runtime.js"
    },
    "./review-maintenance": {
      "types": "./lib/review-maintenance.d.ts",
      "default": "./lib/review-maintenance.js"
    }
  },
  "files": [
    "lib",
    "runtime",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/22-ai-00/dsh-ray.git",
    "directory": "plugins/assistant-verifier"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "protection": {
      "floor": "immutable"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5 <0.3.0",
    "@dsh-ray/assistant-actions": ">=0.1.0 <0.3.0",
    "@dsh-ray/assistant-automations": ">=0.1.24 <0.3.0",
    "@dsh-ray/assistant-delivery": ">=0.1.24 <0.3.0",
    "@dsh-ray/assistant-evaluation": ">=0.1.24 <0.3.0",
    "@dsh-ray/assistant-policy": ">=0.1.0 <0.3.0",
    "@dsh-ray/plugin-control-plane": ">=0.1.0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@dsh-ray/assistant-automations": {
      "optional": true
    },
    "@dsh-ray/assistant-delivery": {
      "optional": true
    },
    "@dsh-ray/assistant-evaluation": {
      "optional": true
    },
    "@dsh-ray/assistant-actions": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@dsh-ray/assistant-policy": {
      "optional": true
    },
    "@dsh-ray/plugin-control-plane": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-agent-default-model": "catalog:",
    "@deepseek-ai/dsh-agent-loop": "catalog:",
    "@deepseek-ai/dsh-agent-loop-testkit": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/dsh-tool-executor-native": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@dsh-ray/assistant-automations": "workspace:*",
    "@dsh-ray/assistant-delivery": "workspace:*",
    "@dsh-ray/assistant-evaluation": "workspace:*",
    "@dsh-ray/assistant-policy": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "@dsh-ray/assistant-growth-contract": "workspace:*",
    "@dsh-ray/assistant-isolation": "workspace:*",
    "@dsh-ray/task-acceptance-contract": "workspace:*"
  }
}
