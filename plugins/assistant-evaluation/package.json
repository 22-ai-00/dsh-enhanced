{
  "name": "@dsh-enhanced/assistant-evaluation",
  "version": "0.1.29",
  "description": "A bounded, append-only outcome evaluation ledger for the DSH personal assistant.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "dsh-benchmark": "./bin/dsh-benchmark.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./benchmark": {
      "types": "./lib/benchmark/index.d.ts",
      "default": "./lib/benchmark/index.js"
    },
    "./benchmark/native": {
      "types": "./lib/benchmark/native.d.ts",
      "default": "./lib/benchmark/native.js"
    },
    "./benchmark/holdout": {
      "types": "./lib/benchmark/holdout.d.ts",
      "default": "./lib/benchmark/holdout.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./benchmark/strategy": {
      "types": "./lib/benchmark/strategy.d.ts",
      "default": "./lib/benchmark/strategy.js"
    },
    "./benchmark/deepseek": {
      "types": "./lib/benchmark/deepseek.d.ts",
      "default": "./lib/benchmark/deepseek.js"
    }
  },
  "files": [
    "bin",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
