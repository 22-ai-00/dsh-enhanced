{
  "name": "dsh-enhanced",
  "version": "0.1.3",
  "private": true,
  "description": "A scalable monorepo for community DeepSeek Harness plugins.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "build:packages": "pnpm --recursive --filter './packages/*' --if-present run build",
    "check": "pnpm run validate && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run pack:check",
    "create:plugin": "node ./scripts/create-plugin.mjs",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "pnpm --recursive --filter './plugins/*' --filter './packages/*' pack --dry-run",
    "release:prepare": "node ./scripts/release-version.mjs prepare",
    "release:publish": "pnpm --recursive --filter './plugins/*' --filter './packages/*' publish --no-git-checks",
    "release:record": "node ./scripts/release-version.mjs record",
    "release:status": "node ./scripts/release-version.mjs status",
    "test": "pnpm run build:packages && vitest run tests && pnpm --recursive --if-present run test",
    "typecheck": "pnpm run build:packages && pnpm --recursive --if-present run typecheck",
    "validate": "node ./scripts/validate-workspace.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-agent-loop": "catalog:",
    "@deepseek-ai/dsh-agent-loop-testkit": "catalog:",
    "@deepseek-ai/dsh-attachment": "catalog:",
    "@deepseek-ai/dsh-attachment-local": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-permission-presets": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-user-approval": "catalog:",
    "@dsh-enhanced/assistant-automations": "workspace:*",
    "@dsh-enhanced/assistant-delivery": "workspace:*",
    "@dsh-enhanced/assistant-evolution": "workspace:*",
    "@dsh-enhanced/assistant-health": "workspace:*",
    "@dsh-enhanced/assistant-heartbeat": "workspace:*",
    "@dsh-enhanced/assistant-policy": "workspace:*",
    "@dsh-enhanced/coding-subscription-provider": "workspace:*",
    "@dsh-enhanced/credentials-keychain": "workspace:*",
    "@dsh-enhanced/lark-channel": "workspace:*",
    "@dsh-enhanced/llm-route-capabilities": "workspace:*",
    "@dsh-enhanced/event-triggers": "workspace:*",
    "@dsh-enhanced/memory-wiki-bridge": "workspace:*",
    "@dsh-enhanced/personal-memory": "workspace:*",
    "@dsh-enhanced/personal-wiki": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
