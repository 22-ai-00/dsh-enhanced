{
  "name": "dsh-ray",
  "version": "0.2.4",
  "private": true,
  "description": "A scalable monorepo for community DeepSeek Harness plugins.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "pnpm run build:bootstrap && pnpm --recursive --workspace-concurrency=1 --if-present run build",
    "build:bootstrap": "pnpm run build:packages && pnpm --filter @dsh-ray/assistant-policy run build && pnpm --filter @dsh-ray/assistant-evaluation run build:core && pnpm --filter @dsh-ray/assistant-delivery run build && pnpm --filter @dsh-ray/assistant-isolation run build && pnpm --filter @dsh-ray/assistant-evaluation run build && pnpm --filter @dsh-ray/assistant-verifier run build && pnpm --filter @dsh-ray/assistant-automations run build && pnpm --filter @dsh-ray/preference-learning run build && pnpm --filter @dsh-ray/assistant-health run build && pnpm --filter @dsh-ray/assistant-evolution run build && pnpm --filter @dsh-ray/assistant-growth-experiments run build && pnpm --filter @dsh-ray/assistant-heartbeat run build && pnpm --filter @dsh-ray/assistant-recovery run build && pnpm --filter @dsh-ray/assistant-goals run build && pnpm --filter @dsh-ray/assistant-skills run build && pnpm --filter @dsh-ray/plugin-control-plane run build && pnpm --filter @dsh-ray/personal-memory run build && pnpm --filter @dsh-ray/assistant-memory-learning run build && pnpm --filter @dsh-ray/credentials-keychain run build && pnpm --filter @dsh-ray/assistant-actions run build && pnpm --filter @dsh-ray/event-triggers run build && pnpm --filter @dsh-ray/assistant-dreaming run build",
    "build:packages": "pnpm --recursive --filter \"./packages/*\" --if-present run build",
    "check": "pnpm run validate && pnpm run lint && pnpm run build && pnpm run typecheck:built && pnpm run test:built && pnpm run pack:check",
    "create:plugin": "node ./scripts/create-plugin.mjs",
    "lint": "oxlint --deny-warnings .",
    "pack:check": "pnpm --recursive --filter './plugins/*' --filter './packages/*' pack --dry-run",
    "release:prepare": "node ./scripts/release-version.mjs prepare",
    "release:publish": "pnpm --recursive --filter './plugins/*' --filter './packages/*' publish --no-git-checks",
    "release:record": "node ./scripts/release-version.mjs record",
    "release:status": "node ./scripts/release-version.mjs status",
    "release:supersede": "node ./scripts/release-version.mjs supersede",
    "test": "pnpm run build && pnpm run test:built",
    "test:built": "pnpm run test:root && pnpm run test:packages",
    "test:packages": "pnpm --recursive --no-sort --if-present --workspace-concurrency=${DSH_TEST_CONCURRENCY:-6} run test --testTimeout=15000",
    "test:packages:control-plane": "pnpm --filter @dsh-ray/plugin-control-plane run test --testTimeout=15000",
    "test:packages:lark-channel": "pnpm --filter @dsh-ray/lark-channel run test --testTimeout=15000",
    "test:packages:rest": "pnpm --recursive --no-sort --if-present --workspace-concurrency=2 --filter '!@dsh-ray/plugin-control-plane' --filter '!@dsh-ray/lark-channel' run test --testTimeout=15000",
    "test:root": "vitest run --config ./tests/vitest.config.ts --testTimeout=15000 --dir tests",
    "test:autonomy": "playwright test --config scripts/e2e/playwright-autonomy.config.mjs",
    "test:autonomy:wake": "playwright test --config scripts/e2e/playwright-wake.config.mjs",
    "test:web-owner": "playwright test --config scripts/e2e/playwright.config.mjs",
    "test:web-owner:real": "playwright test --config scripts/e2e/playwright-real.config.mjs",
    "test:web-owner:real-event": "playwright test --config scripts/e2e/playwright-real-event.config.mjs",
    "typecheck": "pnpm run build && pnpm run typecheck:built",
    "typecheck:built": "pnpm --recursive --if-present run typecheck",
    "validate": "node ./scripts/validate-workspace.mjs",
    "test:autonomy:deepseek": "playwright test --config scripts/e2e/playwright-deepseek.config.mjs",
    "test:autonomy:setup": "playwright test --config scripts/e2e/playwright-goal-setup.config.mjs",
    "test:web-owner:real-skill": "playwright test --config scripts/e2e/playwright-real-skill.config.mjs",
    "test:web-owner:real-capture": "playwright test --config scripts/e2e/playwright-real-capture.config.mjs",
    "test:web-owner:real-canary": "playwright test --config scripts/e2e/playwright-real-canary.config.mjs",
    "test:web-owner:real-repair": "playwright test --config scripts/e2e/playwright-real-repair.config.mjs",
    "test:web-owner:real-repair:topology": "playwright test --config scripts/e2e/playwright-real-repair-topology.config.mjs",
    "check:quick": "pnpm run validate && pnpm run lint && pnpm --filter \"{origin/dev}...\" --if-present run build && pnpm --filter \"{origin/dev}...\" --if-present run typecheck && pnpm --filter \"{origin/dev}\" --if-present run test --testTimeout=15000"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/cordis-plugin-group": "catalog:",
    "@deepseek-ai/cordis-plugin-include": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-agent-loop": "catalog:",
    "@deepseek-ai/dsh-agent-loop-testkit": "catalog:",
    "@deepseek-ai/dsh-attachment": "catalog:",
    "@deepseek-ai/dsh-attachment-local": "catalog:",
    "@deepseek-ai/dsh-atomic-write": "catalog:",
    "@deepseek-ai/dsh-compaction": "catalog:",
    "@deepseek-ai/dsh-compaction-basic": "catalog:",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-permission-presets": "catalog:",
    "@deepseek-ai/dsh-sandbox": "catalog:",
    "@deepseek-ai/dsh-scope": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-persistence": "catalog:",
    "@deepseek-ai/dsh-session-persistence-jsonl": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/dsh-shell": "catalog:",
    "@deepseek-ai/dsh-skill": "catalog:",
    "@deepseek-ai/dsh-subprocess": "catalog:",
    "@deepseek-ai/dsh-tool-skill": "catalog:",
    "@deepseek-ai/dsh-tool-executor-ptc": "catalog:",
    "@deepseek-ai/dsh-token-meter": "catalog:",
    "@deepseek-ai/dsh-user-approval": "catalog:",
    "@dsh-ray/assistant-automations": "workspace:*",
    "@dsh-ray/assistant-delivery": "workspace:*",
    "@dsh-ray/assistant-evaluation": "workspace:*",
    "@dsh-ray/assistant-evolution": "workspace:*",
    "@dsh-ray/assistant-growth-contract": "workspace:*",
    "@dsh-ray/assistant-health": "workspace:*",
    "@dsh-ray/assistant-heartbeat": "workspace:*",
    "@dsh-ray/assistant-policy": "workspace:*",
    "@dsh-ray/assistant-recovery": "workspace:*",
    "@dsh-ray/coding-subscription-provider": "workspace:*",
    "@dsh-ray/credentials-keychain": "workspace:*",
    "@dsh-ray/lark-channel": "workspace:*",
    "@dsh-ray/llm-route-capabilities": "workspace:*",
    "@dsh-ray/event-triggers": "workspace:*",
    "@dsh-ray/memory-wiki-bridge": "workspace:*",
    "@dsh-ray/personal-memory": "workspace:*",
    "@dsh-ray/personal-wiki": "workspace:*",
    "@dsh-ray/preference-learning": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.0",
    "@dsh-ray/task-acceptance-contract": "workspace:*",
    "@dsh-ray/assistant-verifier": "workspace:*",
    "@deepseek-ai/dsh-agent-default-model": "catalog:",
    "@deepseek-ai/dsh-session-query": "catalog:",
    "@deepseek-ai/dsh-typert-registry": "catalog:",
    "@playwright/test": "1.58.2",
    "@deepseek-ai/dsh-fs": "catalog:",
    "@deepseek-ai/dsh-fs-local": "catalog:",
    "@deepseek-ai/dsh-tool-fs": "catalog:",
    "@deepseek-ai/dsh-subagent": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-file-reference": "catalog:",
    "@deepseek-ai/dsh-native-command": "catalog:",
    "@deepseek-ai/dsh-util-time": "catalog:",
    "@deepseek-ai/dsh-util-workspace-path": "catalog:",
    "@deepseek-ai/dsh-llm-retry": "catalog:",
    "@deepseek-ai/dsh-storage": "catalog:",
    "@deepseek-ai/dsh-storage-domain": "catalog:",
    "@deepseek-ai/cordis-plugin-loader": "catalog:",
    "@deepseek-ai/dsh-tool-executor-native": "catalog:"
  }
}
